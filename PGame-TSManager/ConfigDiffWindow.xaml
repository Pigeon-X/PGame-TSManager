<Window x:Class="PGameTSManager.ConfigDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置变更预览" Height="620" Width="820" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlassPanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlassPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DiffLineTemplate">
            <Grid Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Marker}" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="{DynamicResource Warn}" VerticalAlignment="Top"/>
                <TextBlock x:Name="TextLine" Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas, Microsoft YaHei UI"
                           FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Text}" VerticalAlignment="Top"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Add">
                    <Setter TargetName="TextLine" Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Remove">
                    <Setter TargetName="TextLine" Property="Foreground" Value="{DynamicResource Err}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Margin="6" CornerRadius="14" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="配置变更预览" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="按分类显示本次保存会新增、删除或修改的配置行；确认后才写入文件。"
                                   Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DiffSearch" Height="28" FontSize="11.5" Padding="7,0"
                                     TextChanged="DiffSearch_TextChanged" ToolTip="筛选配置键或值"/>
                            <Button Grid.Column="1" Content="导出差异" Style="{StaticResource DlgBtn}"
                                    Click="Export_Click" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TabControl Grid.Row="1" x:Name="Tabs" Margin="0,10,0,0"
                                Background="Transparent" BorderThickness="0"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="返回修改" Style="{StaticResource DlgBtn}" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Content="确认保存" Style="{StaticResource DlgBtn}"
                                Background="{DynamicResource Ok}" Foreground="{DynamicResource BtnText}"
                                Click="Confirm_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
