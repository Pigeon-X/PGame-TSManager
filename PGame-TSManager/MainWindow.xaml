<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PGameTSManager"
        xmlns:Linq="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" x:Class="PGameTSManager.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
        Title="PGame-TSManager" Height="700" Width="1120" MinHeight="560" MinWidth="960"
        Name="Window" Loaded="Window_Loaded" Icon="PGame-TSManager.ico"
        WindowState="Normal" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 窗口底色：极光渐变（不是系统模糊，Win10/11 表现一致，RDP 里也不会掉效果） -->
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Backdrop1}" Offset="0"/>
            <GradientStop Color="{DynamicResource Backdrop2}" Offset="0.55"/>
            <GradientStop Color="{DynamicResource Backdrop3}" Offset="1"/>
        </LinearGradientBrush>

        <!-- 玻璃按钮 -->
        <Style TargetType="Button" x:Key="BaseBtn">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                            <Grid>
                                <Border x:Name="sheen" CornerRadius="11" VerticalAlignment="Top" Height="1" Margin="2,1,2,0"
                                        Background="{DynamicResource GlassHi}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StartBtn">
            <Setter Property="Background" Value="{DynamicResource Ok}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StopBtn">
            <Setter Property="Background" Value="{DynamicResource Err}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="AccentBtn">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="NeutralBtn">
            <Setter Property="Background" Value="{DynamicResource GlassPanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <!-- 玻璃下拉框 -->
        <Style x:Key="TShockCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="cb" Background="{DynamicResource GlassPanel}" CornerRadius="11"
                                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Accent2}" StrokeThickness="1.8"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,34,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ConsoleBg}" CornerRadius="12" Margin="0,4,0,0"
                                        BorderBrush="{DynamicResource Accent2}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,2,1,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="{DynamicResource ScrollThumb}" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource ScrollThumbHot}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 两团极光光斑 = 液态玻璃后面的“颜色在流动” -->
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-260,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Blob1}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Blob2}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 玻璃主卡片 -->
        <Border Margin="10" CornerRadius="16" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <!-- 顶部高光条 -->
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>

                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第 1 行：选服 + 单服启停 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- ★ 选服框不再拉满整行，固定在左上角（300 宽） -->
                        <ComboBox Grid.Column="0" x:Name="ComboBox" Style="{StaticResource TShockCombo}"
                                  Width="300" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Containers, ElementName=Window, Mode=OneWay}"
                                  SelectionChanged="ComboBox_SelectionChanged" ToolTip="选择服务器（按目录序号 1. 2. 3. 自动排序）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                                        <TextBlock Text="{Binding ListLabel}" Foreground="{DynamicResource Text}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="{Binding StatusBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" x:Name="StartButton" Content="启动本服" Style="{StaticResource StartBtn}" Click="StartButton_Click"
                                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                                IsEnabled="{Binding Path=IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Grid.Column="3" x:Name="KillButton" Content="停止本服" Style="{StaticResource StopBtn}" Click="KillButton_Click"
                                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                                IsEnabled="{Binding IsRunning, Mode=OneWay}"/>
                    </Grid>

                    <!-- 控制台 -->
                    <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Background="{DynamicResource ConsoleBg}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                        <RichTextBox x:Name="CliTextBox" Background="Transparent" Foreground="{DynamicResource LogNormal}"
                                     BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13.5" IsReadOnly="True"
                                     Padding="12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                     ToolTip="服务器控制台输出（可上下滚动）"/>
                    </Border>

                    <!-- 输入 + 发送 -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="InputBorder" Grid.Column="0" Background="{DynamicResource InputBg}" CornerRadius="11">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="输入指令，例如  /help    /save    /ac status"
                                           Foreground="{DynamicResource TextDim}" FontSize="14"
                                           VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                                <TextBox x:Name="TextBox" Background="Transparent" Foreground="{DynamicResource Text}"
                                         CaretBrush="{DynamicResource Accent2}"
                                         BorderThickness="0" FontSize="14" Height="42" VerticalContentAlignment="Center"
                                         Padding="12,0" PreviewKeyDown="TextBox_PreviewKeyDown" TextChanged="TextBox_TextChanged"
                                         ToolTip="输入指令后回车（走该服 REST 的 v3/server/rawcmd 发送）"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="发送" Style="{StaticResource AccentBtn}" Click="SendCurrentButton_Click" ToolTip="发送给当前选中的服务器"/>
                        <Button Grid.Column="2" Content="全部发送" Style="{StaticResource NeutralBtn}" Click="SendAllButton_Click" ToolTip="发送给所有正在运行的服务器"/>
                    </Grid>

                    <!-- 全局启停 -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" x:Name="StartAllButton" Content="全部启动（顺序）" Style="{StaticResource StartBtn}" Click="StartAllButton_Click" ToolTip="按顺序逐台启动：上一台就绪后再起下一台"/>
                        <Button Grid.Column="2" Content="全部停止" Style="{StaticResource StopBtn}" Click="StopAllButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>