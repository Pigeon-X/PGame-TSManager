<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PGameTSManager"
        xmlns:Linq="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" x:Class="PGameTSManager.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
        Title="PGame-TSManager" Height="700" Width="1120" MinHeight="560" MinWidth="960"
        Name="Window" Loaded="Window_Loaded" Icon="PGame-TSManager.ico"
        WindowState="Normal" ShowInTaskbar="True"
        Background="{DynamicResource Bg}" FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 按钮：加大、留白，不再挤在一起 -->
        <Style TargetType="Button" x:Key="BaseBtn">
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StartBtn"><Setter Property="Background" Value="{DynamicResource Ok}"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StopBtn"><Setter Property="Background" Value="{DynamicResource Err}"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="AccentBtn"><Setter Property="Background" Value="{DynamicResource Accent}"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="NeutralBtn">
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="TShockCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource Panel}" CornerRadius="5"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextDim}" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,38,0" VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <ScrollViewer><StackPanel IsItemsHost="True" Margin="6"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第 1 行：选服 + 单服启停 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ComboBox" Style="{StaticResource TShockCombo}"
                      ItemsSource="{Binding Containers, ElementName=Window, Mode=OneWay}"
                      SelectionChanged="ComboBox_SelectionChanged" ToolTip="选择服务器">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="{Binding StatusBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" x:Name="StartButton" Content="启动本服" Style="{StaticResource StartBtn}" Click="StartButton_Click"
                    DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                    IsEnabled="{Binding Path=IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Grid.Column="2" x:Name="KillButton" Content="停止本服" Style="{StaticResource StopBtn}" Click="KillButton_Click"
                    DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                    IsEnabled="{Binding IsRunning, Mode=OneWay}"/>
        </Grid>

        <!-- 控制台 -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="5" Background="{DynamicResource ConsoleBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <RichTextBox x:Name="CliTextBox" Background="Transparent" Foreground="{DynamicResource LogNormal}"
                         BorderThickness="0" FontFamily="Consolas" FontSize="13.5" IsReadOnly="True"
                         Padding="12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                         ToolTip="服务器控制台输出"/>
        </Border>

        <!-- 输入 + 发送 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="5"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <TextBox x:Name="TextBox" Background="Transparent" Foreground="{DynamicResource Text}"
                         BorderThickness="0" FontSize="14" Height="40" VerticalContentAlignment="Center"
                         Padding="12,0" PreviewKeyDown="TextBox_PreviewKeyDown" ToolTip="输入指令后回车（走该服 REST 发送）"/>
            </Border>
            <Button Grid.Column="1" Content="发送" Style="{StaticResource AccentBtn}" Click="SendCurrentButton_Click" ToolTip="发送给当前选中的服务器"/>
            <Button Grid.Column="2" Content="全部发送" Style="{StaticResource NeutralBtn}" Click="SendAllButton_Click" ToolTip="发送给所有正在运行的服务器"/>
        </Grid>

        <!-- 全局启停 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="12"
                       Text="三服后台隐藏运行 · 日志实时回显 · 指令走 REST 下发"/>
            <Button Grid.Column="1" Content="全部启动" Style="{StaticResource StartBtn}" Click="StartAllButton_Click"/>
            <Button Grid.Column="2" Content="全部停止" Style="{StaticResource StopBtn}" Click="StopAllButton_Click"/>
        </Grid>
    </Grid>
</Window>