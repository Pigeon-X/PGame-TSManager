<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PGameTSManager"
        xmlns:Linq="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" x:Class="PGameTSManager.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
        Title="PGame-TSManager" Height="640" Width="1040" MinHeight="480" MinWidth="820"
        Name="Window" Loaded="Window_Loaded" Icon="PGame-TSManager.ico"
        WindowState="Normal" ShowInTaskbar="True"
        Background="#1B1B26" FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 调色板：配套 logo 的 蓝 -> 紫 -->
        <SolidColorBrush x:Key="Bg"          Color="#1B1B26"/>
        <SolidColorBrush x:Key="Panel"       Color="#23232F"/>
        <SolidColorBrush x:Key="PanelHi"     Color="#2C2C3A"/>
        <SolidColorBrush x:Key="Text"        Color="#E6E6EE"/>
        <SolidColorBrush x:Key="TextDim"     Color="#9AA0B4"/>
        <SolidColorBrush x:Key="Blue"        Color="#4C8DF6"/>
        <SolidColorBrush x:Key="Purple"      Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Green"       Color="#22C55E"/>
        <SolidColorBrush x:Key="Red"         Color="#EF4444"/>
        <SolidColorBrush x:Key="Amber"       Color="#F59E0B"/>

        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4C8DF6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Panel}" CornerRadius="6" BorderBrush="#3A3A4C" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextDim}" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,34,0" VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#23232F" BorderBrush="#3A3A4C" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                                    <ScrollViewer><StackPanel IsItemsHost="True" Margin="4"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BaseBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StartBtn">
            <Setter Property="Background" Value="{StaticResource Green}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StopBtn">
            <Setter Property="Background" Value="{StaticResource Red}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="NeutralBtn">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="AccentBtn">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- 服务器选择 + 单服启停 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent">
                <ComboBox x:Name="ComboBox" Style="{StaticResource DarkCombo}"
                          ItemsSource="{Binding Containers, ElementName=Window, Mode=OneWay}"
                          SelectionChanged="ComboBox_SelectionChanged" ToolTip="选择服务器">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="2,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0"
                                           Foreground="{Binding StatusBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>

            <Button Grid.Column="1" x:Name="StartButton" Content="启动" Style="{StaticResource StartBtn}"
                    Click="StartButton_Click"
                    DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                    IsEnabled="{Binding Path=IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Grid.Column="2" x:Name="KillButton" Content="停止" Style="{StaticResource StopBtn}"
                    Click="KillButton_Click"
                    DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                    IsEnabled="{Binding IsRunning, Mode=OneWay}"/>
        </Grid>

        <!-- 控制台 -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8" Background="#0E0E14" BorderBrush="#2A2A3A" BorderThickness="1">
            <RichTextBox x:Name="CliTextBox" Background="Transparent" Foreground="{StaticResource Text}"
                         BorderThickness="0" FontFamily="Consolas" FontSize="13" IsReadOnly="True"
                         Padding="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                         ToolTip="服务器控制台输出（按级别着色）"/>
        </Border>

        <!-- 输入 + 发送 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="8,0">
                <TextBox x:Name="TextBox" Background="Transparent" Foreground="{StaticResource Text}"
                         BorderThickness="0" FontSize="14" Height="36" VerticalContentAlignment="Center"
                         PreviewKeyDown="TextBox_PreviewKeyDown"
                         ToolTip="输入指令后回车（走该服 REST 发送）"/>
            </Border>
            <Button Grid.Column="1" Content="发送" Style="{StaticResource AccentBtn}" Click="SendCurrentButton_Click"
                    ToolTip="发送给当前选中的服务器"/>
            <Button Grid.Column="2" Content="全部发送" Style="{StaticResource NeutralBtn}" Click="SendAllButton_Click"
                    ToolTip="发送给所有正在运行的服务器"/>
        </Grid>

        <!-- 全局启停 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                       Text="服务器在后台隐藏运行；日志显示在上面，指令走 REST 下发"/>
            <Button Grid.Column="1" Content="全部启动" Style="{StaticResource StartBtn}" Click="StartAllButton_Click"/>
            <Button Grid.Column="2" Content="全部停止" Style="{StaticResource StopBtn}" Click="StopAllButton_Click"/>
        </Grid>
    </Grid>
</Window>