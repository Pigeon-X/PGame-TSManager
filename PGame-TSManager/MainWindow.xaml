<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PGameTSManager"
        xmlns:Linq="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" x:Class="PGameTSManager.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
        Title="{Binding Path=Title, Mode=OneWay}" Height="520" Width="860" Name="Window" Loaded="Window_Loaded" Icon="PGame-TSManager.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0" Grid.Column="0" x:Name="ComboBox" Margin="5" VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch" ItemsSource="{Binding Containers, ElementName=Window, Mode=OneWay}"
                  SelectionChanged="ComboBox_SelectionChanged" ToolTip="选择服务器">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox HorizontalAlignment="Center" Margin="5" Content="{Binding Name}"
                              IsChecked="{Binding IsRunning}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="StartButton" Margin="5" Content="启动" HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" Grid.Row="0" Grid.Column="1" Click="StartButton_Click"
                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                IsEnabled="{Binding Path=IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" />
        <Button x:Name="KillButton" Margin="5" Content="停止" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Grid.Row="0" Grid.Column="2" Click="KillButton_Click"
                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                IsEnabled="{Binding IsRunning, Mode=OneWay}" />

        <RichTextBox x:Name="CliTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="Black"
                     Foreground="LightGray" FontFamily="Consolas" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                     ToolTip="服务器控制台输出" />

        <TextBox x:Name="TextBox" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="2"
                 Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="NoWrap" FontSize="15"
                 PreviewKeyDown="TextBox_PreviewKeyDown" ToolTip="输入服务器指令后按回车发送" />
        <Button x:Name="SendAllButton" Margin="5" Content="全部发送" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Grid.Row="2" Grid.Column="2" Click="SendAllButton_Click" ToolTip="把输入框内容发送给所有正在运行的服务器" />


        <Button x:Name="StartAllButton" Margin="5" Content="全部启动" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Grid.Row="3" Grid.Column="1" Click="StartAllButton_Click" ToolTip="依次启动全部服务器（按 config.json 的 arguments 启动）" />
        <Button x:Name="StopAllButton" Margin="5" Content="全部停止" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Grid.Row="3" Grid.Column="2" Click="StopAllButton_Click" ToolTip="停止所有正在运行的服务器" />
    </Grid>
</Window>