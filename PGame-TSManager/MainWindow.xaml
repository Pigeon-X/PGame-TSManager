<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PGameTSManager"
        xmlns:Linq="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" x:Class="PGameTSManager.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
        Title="PGame-TSManager" Height="760" Width="1120" MinHeight="620" MinWidth="960"
        Name="Window" Loaded="Window_Loaded" Icon="PGame-TSManager.ico"
        WindowState="Normal" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 窗口底色：极光渐变（不是系统模糊，Win10/11 表现一致，RDP 里也不会掉效果） -->
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Backdrop1}" Offset="0"/>
            <GradientStop Color="{DynamicResource Backdrop2}" Offset="0.55"/>
            <GradientStop Color="{DynamicResource Backdrop3}" Offset="1"/>
        </LinearGradientBrush>

        <!-- 玻璃按钮 -->
        <Style TargetType="Button" x:Key="BaseBtn">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                            <Grid>
                                <Border x:Name="sheen" CornerRadius="11" VerticalAlignment="Top" Height="1" Margin="2,1,2,0"
                                        Background="{DynamicResource GlassHi}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StartBtn">
            <Setter Property="Background" Value="{DynamicResource Ok}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="StopBtn">
            <Setter Property="Background" Value="{DynamicResource Err}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="AccentBtn">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}" x:Key="NeutralBtn">
            <Setter Property="Background" Value="{DynamicResource GlassPanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style TargetType="RadioButton" x:Key="WorkspaceTabButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="0,0,5,0">
                            <ContentPresenter ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlassPanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlassPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃菜单栏 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Chevron" Text="▾" Foreground="{DynamicResource TextDim}"
                                               HorizontalAlignment="Right" Margin="10,0,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource ConsoleBg}" BorderBrush="{DynamicResource AccentBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="168">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource GlassPanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource GlassPanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃下拉框 -->
        <Style x:Key="TShockCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="cb" Background="{DynamicResource GlassPanel}" CornerRadius="11"
                                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Accent2}" StrokeThickness="1.8"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,26,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ConsoleBg}" CornerRadius="12" Margin="0,4,0,0"
                                        BorderBrush="{DynamicResource Accent2}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,2,1,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="{DynamicResource ScrollThumb}" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource ScrollThumbHot}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 两团极光光斑 = 液态玻璃后面的“颜色在流动” -->
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-260,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Blob1}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Blob2}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 玻璃主卡片 -->
        <Border Margin="8" CornerRadius="16" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <!-- 顶部高光条 -->
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>

                <Grid Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部一行：菜单 + 选服 + 右侧启停按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Text}"
                              FontSize="11.5" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <MenuItem Header="服务器">
                                <MenuItem x:Name="MenuStartCurrent" Header="启动本服" Foreground="{DynamicResource Ok}"
                                          Click="StartButton_Click"/>
                                <MenuItem x:Name="MenuStopCurrent" Header="停止本服" Foreground="{DynamicResource Err}"
                                          Click="KillButton_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuStartAll" Header="全部启动" Foreground="{DynamicResource Ok}"
                                          Click="StartAllButton_Click"/>
                                <MenuItem x:Name="MenuStopAll" Header="全部停止" Foreground="{DynamicResource Err}"
                                          Click="StopAllButton_Click"/>
                            </MenuItem>
                            <MenuItem Header="管理">
                                <MenuItem Header="服务器设置" Click="ServerSettingsButton_Click"/>
                                <MenuItem Header="插件开关" Click="PluginButton_Click"/>
                                <MenuItem Header="玩家管理" Click="PlayerManager_Click"/>
                                <MenuItem Header="插件检查" Click="PluginCheck_Click"/>
                                <MenuItem Header="计划任务" Click="Schedule_Click"/>
                                <MenuItem Header="回滚中心" Click="RollbackFromMenu_Click"/>
                                <Separator/>
                                <MenuItem Header="新建服务器" Click="NewServerButton_Click"/>
                                <MenuItem Header="刷新服务器列表" Click="RefreshButton_Click"/>
                            </MenuItem>
                            <MenuItem Header="工具">
                                <MenuItem Header="保存世界" Click="QuickSave_Click"/>
                            </MenuItem>
                        </Menu>

                        <ComboBox Grid.Column="1" x:Name="ComboBox" Style="{StaticResource TShockCombo}"
                                  Width="290" Height="28" Margin="10,0,0,0" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Containers, ElementName=Window, Mode=OneWay}"
                                  SelectionChanged="ComboBox_SelectionChanged" ToolTip="选择服务器（按目录序号 1. 2. 3. 自动排序）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="2,0,7,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                                        <TextBlock Text="{Binding ListLabel}" Foreground="{DynamicResource Text}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" Foreground="{Binding StatusBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="18,0,0,0">
                            <RadioButton x:Name="ConsolePageButton" Content="控制台" GroupName="WorkspacePage"
                                         Style="{StaticResource WorkspaceTabButton}" IsChecked="True"
                                         Checked="WorkspacePage_Checked"/>
                            <RadioButton x:Name="OperationsPageButton" Content="运维中心" GroupName="WorkspacePage"
                                         Style="{StaticResource WorkspaceTabButton}"
                                         Checked="WorkspacePage_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="StartButton" Content="启动本服" Style="{StaticResource StartBtn}" Click="StartButton_Click"
                                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                                IsEnabled="{Binding Path=IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button x:Name="KillButton" Content="停止本服" Style="{StaticResource StopBtn}" Click="KillButton_Click"
                                DataContext="{Binding SelectedItem, ElementName=ComboBox, Converter={StaticResource ToContainerConverter}}"
                                IsEnabled="{Binding IsRunning, Mode=OneWay}"/>
                            <Button x:Name="StartAllButton" Content="全部启动" Style="{StaticResource StartBtn}" Click="StartAllButton_Click"
                                    ToolTip="按顺序逐台启动：上一台就绪后再起下一台"/>
                            <Button x:Name="StopAllButton" Content="全部停止" Style="{StaticResource StopBtn}" Click="StopAllButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 主内容页：第一行页签切换 -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Border x:Name="ConsolePage" CornerRadius="12" Background="{DynamicResource ConsoleBg}"
                                BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                            <RichTextBox x:Name="CliTextBox" Background="Transparent" Foreground="{DynamicResource LogNormal}"
                                         BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5" IsReadOnly="True"
                                         Padding="9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                         ToolTip="服务器控制台输出（可上下滚动）"/>
                        </Border>
                        <local:OperationsCenterView x:Name="OperationsView" Visibility="Collapsed"/>
                    </Grid>

                    <!-- 最底部：只保留一行指令输入 -->
                    <Grid x:Name="CommandBar" Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="InputBorder" Grid.Column="0" Background="{DynamicResource InputBg}" CornerRadius="11">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="输入指令，例如  /help    /save    /hr help"
                                           Foreground="{DynamicResource TextDim}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                <TextBox x:Name="TextBox" Background="Transparent" Foreground="{DynamicResource Text}"
                                         CaretBrush="{DynamicResource Accent2}"
                                         BorderThickness="0" FontSize="12.5" Height="28" VerticalContentAlignment="Center"
                                         Padding="9,0" PreviewKeyDown="TextBox_PreviewKeyDown" TextChanged="TextBox_TextChanged"
                                         ToolTip="输入指令后回车（走该服 REST 的 v3/server/rawcmd 发送）"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="发送" Style="{StaticResource AccentBtn}" Click="SendCurrentButton_Click" ToolTip="发送给当前选中的服务器"/>
                        <Button Grid.Column="2" Content="全部发送" Style="{StaticResource NeutralBtn}" Click="SendAllButton_Click" ToolTip="发送给所有正在运行的服务器"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
