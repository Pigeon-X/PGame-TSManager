<Window x:Class="PGameTSManager.PlayerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="玩家与权限管理" Height="580" Width="800" MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Grid>
        <Border Margin="6" CornerRadius="14" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="Header" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="在线玩家来自 TShock REST；所有操作都通过该服管理员令牌执行。"
                                   Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="PlayerList" Margin="0,10,0,0"
                             Background="{DynamicResource ConsoleBg}" BorderBrush="{DynamicResource AccentBorder}"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="11.5" Foreground="{DynamicResource Accent2}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Ip}" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="刷新" Style="{StaticResource DlgBtn}" Click="Refresh_Click"/>
                            <Button Content="静默" Style="{StaticResource DlgBtn}" Click="Mute_Click"/>
                            <Button Content="解除静默" Style="{StaticResource DlgBtn}" Click="Unmute_Click"/>
                            <Button Content="击杀" Style="{StaticResource DlgBtn}" Click="Kill_Click"/>
                            <Button Content="踢出" Style="{StaticResource DlgBtn}" Click="Kick_Click"/>
                            <Button Content="封禁" Style="{StaticResource DlgBtn}" Background="{DynamicResource Err}"
                                    Foreground="{DynamicResource BtnText}" Click="Ban_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
