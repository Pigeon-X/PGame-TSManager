<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PGame-TSManager</AssemblyName>
    <RootNamespace>PGameTSManager</RootNamespace>
    <AssemblyTitle>PGame-TSManager</AssemblyTitle>
    <Product>PGame-TSManager</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>PGame-TSManager.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="PGame-TSManager.ico" />
    <Resource Include="PGame-TSManager-logo.png" />
        <None Update="Data\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    <None Update="Plugins\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\TerrariaServerAPI\TerrariaServerAPI\ServerConfig.cs" />
  </ItemGroup>

</Project>
