<UserControl x:Class="PGameTSManager.OperationsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlassPanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="{DynamicResource GlassBg}"
            BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="运维中心" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <TextBlock Text="健康状态和日志检索集中在这里。"
                           Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
            </StackPanel>
            <TabControl Grid.Row="1" x:Name="Tabs" Margin="0,10,0,0"
                        Background="Transparent" BorderThickness="0">
                <TabItem Header="健康状态">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="HealthList" Background="{DynamicResource ConsoleBg}"
                                 BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,5" CornerRadius="7" Background="{DynamicResource GlassPanel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11.5" Foreground="{Binding StateBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Pid}" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Memory}" FontSize="11" Foreground="{DynamicResource Info}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Ports}" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextDim}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="刷新健康" Style="{StaticResource DlgBtn}" Click="RefreshHealth_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="日志中心">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LogServerBox" Height="28" FontSize="11.5" SelectionChanged="LogServer_SelectionChanged"/>
                            <TextBox x:Name="LogFilter" Grid.Column="1" Height="28" Margin="8,0,0,0"
                                     Padding="7,0" FontSize="11.5" TextChanged="LogFilter_TextChanged"
                                     ToolTip="筛选关键字，例如 Exception、插件名、Warning"/>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="LogText" IsReadOnly="True" AcceptsReturn="True"
                                 Height="Auto" MinHeight="220" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ConsoleBg}" Foreground="{DynamicResource Text}"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Padding="8"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock x:Name="LogStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextDim}" Margin="0,0,10,0"/>
                            <Button Content="只看异常" Style="{StaticResource DlgBtn}" Click="ErrorsOnly_Click"/>
                            <Button Content="打开日志目录" Style="{StaticResource DlgBtn}" Click="OpenLogs_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>
