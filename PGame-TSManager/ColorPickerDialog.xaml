<Window x:Class="PGameTSManager.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调色板" Height="430" Width="520" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Grid>
        <Border Margin="6" CornerRadius="14" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="聊天颜色调色板（RGB）" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="点击预设颜色，或直接修改 R / G / B 数值。保存后写入 SSC 颜色数组。"
                                   Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" x:Name="Palette" Columns="10" Rows="4" Margin="0,12,0,12"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="RBox" TextChanged="Rgb_TextChanged" ToolTip="0-255"/>
                        <TextBlock Grid.Column="2" Text="G" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Column="3" x:Name="GBox" TextChanged="Rgb_TextChanged" ToolTip="0-255"/>
                        <TextBlock Grid.Column="4" Text="B" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Column="5" x:Name="BBox" TextChanged="Rgb_TextChanged" ToolTip="0-255"/>
                    </Grid>

                    <Border Grid.Row="3" Height="46" Margin="0,12,0,0" CornerRadius="9"
                            Background="{DynamicResource GlassPanel}" BorderBrush="{DynamicResource GlassBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Border x:Name="Preview" Margin="6" CornerRadius="6"/>
                            <TextBlock x:Name="PreviewText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource Text}"
                                       Text="#FFFFFF"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Style="{StaticResource DlgBtn}" Click="Cancel_Click"/>
                        <Button Content="确定" Style="{StaticResource DlgBtn}"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"
                                Click="Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
