<Window x:Class="PGameTSManager.PluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件开关" Height="580" Width="540" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DlgBtn">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.86"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.32"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="SubHeader" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextDim}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="12" Background="{DynamicResource ConsoleBg}"
                BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,5" Foreground="{DynamicResource Text}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextDim}" FontSize="12" Margin="10,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource DlgBtn}" Background="{DynamicResource GlassPanelHi}" Click="Cancel_Click"/>
            <Button Content="保存" Style="{StaticResource DlgBtn}" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="Save_Click"/>
            <Button Content="保存并重启本服" Style="{StaticResource DlgBtn}" Background="{DynamicResource Ok}" Foreground="{DynamicResource BtnText}" Click="SaveRestart_Click"/>
        </StackPanel>
    </Grid>
</Window>