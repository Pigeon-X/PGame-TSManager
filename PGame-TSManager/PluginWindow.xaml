<Window x:Class="PGameTSManager.PluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件开关" Height="600" Width="560" MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>

                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="SubHeader" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="12" Background="{DynamicResource ConsoleBg}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                            <ItemsControl x:Name="List">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,5"
                                                  Foreground="{DynamicResource Text}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13"/>
                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextDim}"
                                                           FontSize="12" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="取消" Style="{StaticResource DlgBtn}" Click="Cancel_Click"/>
                        <Button Content="保存" Style="{StaticResource DlgBtn}"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="Save_Click"/>
                        <Button Content="保存并重启本服" Style="{StaticResource DlgBtn}"
                                Background="{DynamicResource Ok}" Foreground="{DynamicResource BtnText}" Click="SaveRestart_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>