<Window x:Class="PGameTSManager.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建服务器" Height="440" Width="560" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DlgBtn">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.86"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="新建服务器"/>
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                       Text="目录会自动取下一个序号（已有 1./2./3. → 新建就是 4.）。tshock 配置从模板服复制，创建完再按提示改端口与数据库。"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="服务器名"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10" ToolTip="例如：生存服（不要带序号）"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="游戏端口"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Margin="0,0,0,10" ToolTip="例如 2025"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="REST 端口"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="RestBox" Margin="0,0,0,10" ToolTip="例如 7881"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="世界文件"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="WorldBox" Margin="0,0,0,10" ToolTip="留空 = 用 名字.wld"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="模板服"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TemplateBox" Height="36" FontSize="14"
                      Background="{DynamicResource InputBg}" Foreground="{DynamicResource Text}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource DlgBtn}" Background="{DynamicResource GlassPanelHi}" Click="Cancel_Click"/>
            <Button Content="创建" Style="{StaticResource DlgBtn}" Background="{DynamicResource Accent}"
                    Foreground="{DynamicResource AccentText}" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>