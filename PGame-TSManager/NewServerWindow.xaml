<Window x:Class="PGameTSManager.NewServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建服务器" Height="470" Width="600" MinHeight="440" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackdrop}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="{DynamicResource GlassBg}"
                BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="16,1,16,0" Background="{DynamicResource GlassHi}"/>

                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="新建服务器"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                                   Text="目录会自动取下一个序号（已有 1./2./3. → 新建就是 4.）。tshock 配置从模板服复制，创建完再按提示改端口与数据库。"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="服务器名"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10" ToolTip="例如：生存服（不要带序号）"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="游戏端口"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Margin="0,0,0,10" ToolTip="例如 2025"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="REST 端口"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="RestBox" Margin="0,0,0,10" ToolTip="例如 7881"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="世界文件"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="WorldBox" Margin="0,0,0,10" ToolTip="留空 = 用 名字.wld"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="模板服"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TemplateBox"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Style="{StaticResource DlgBtn}" Click="Cancel_Click"/>
                        <Button Content="创建" Style="{StaticResource DlgBtn}"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="Create_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>